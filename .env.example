# ------------------------------------------------------------------
# StockScope AI — environment variables
# Copy this file to `.env.local` and fill in the values you have.
# The app runs in "demo mode" when AI / Stripe keys are missing, so
# you can develop and demo the full dashboard without any keys.
# ------------------------------------------------------------------

# --- OpenRouter (AI analysis) -------------------------------------
# Get a key at https://openrouter.ai/keys
# Without this key, the AI Research tab clearly reports that live
# analysis is unavailable (it will NOT fabricate AI content).
OPENROUTER_API_KEY=
# Any OpenRouter-compatible model id. A model that supports structured
# JSON output is strongly recommended.
OPENROUTER_MODEL=openai/gpt-4o-mini
# Optional attribution headers recommended by OpenRouter.
OPENROUTER_APP_URL=http://localhost:3000
OPENROUTER_APP_NAME=StockScope AI

# --- Stripe (sandbox / test mode ONLY) ----------------------------
# Use TEST keys only (sk_test_... / pk_test_...). Never use live keys.
# Without these, the "Unlock Premium Report" button shows a friendly
# "setup required" state instead of a broken payment button.
STRIPE_SECRET_KEY=
NEXT_PUBLIC_STRIPE_PUBLISHABLE_KEY=
# From `stripe listen` or the Stripe dashboard webhook settings.
STRIPE_WEBHOOK_SECRET=

# --- App ----------------------------------------------------------
# Public base URL used for Stripe success/cancel redirect URLs.
NEXT_PUBLIC_APP_URL=http://localhost:3000
