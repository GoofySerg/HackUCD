{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "$id": "https://stockscope.ai/schemas/company.schema.json",
  "title": "StockScope Canonical Company Dataset",
  "description": "JSON Schema mirror of the canonical company shape. The authoritative validator is the Zod schema in src/lib/data/validation.ts; this file is provided for editor tooling and documentation.",
  "type": "object",
  "required": ["identity", "statements", "sources", "dataType", "datasetVersion"],
  "properties": {
    "schemaFormat": { "type": "string" },
    "dataType": { "enum": ["real", "synthetic"] },
    "datasetVersion": { "type": "string", "minLength": 1 },
    "identity": {
      "type": "object",
      "required": ["ticker", "companyName", "sector", "industry", "description", "currency", "exchange"],
      "properties": {
        "ticker": { "type": "string", "minLength": 1, "maxLength": 12 },
        "companyName": { "type": "string", "minLength": 1 },
        "sector": { "type": "string", "minLength": 1 },
        "industry": { "type": "string", "minLength": 1 },
        "description": { "type": "string", "minLength": 1 },
        "currency": { "type": "string", "pattern": "^[A-Z]{3}$" },
        "exchange": { "type": "string", "minLength": 1 }
      }
    },
    "statements": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "required": ["id", "fiscalYear", "fiscalPeriodEnd"],
        "properties": {
          "id": { "type": "string", "minLength": 1 },
          "fiscalYear": { "type": "integer", "minimum": 1900, "maximum": 2100 },
          "fiscalPeriodEnd": { "type": "string", "pattern": "^\\d{4}-\\d{2}-\\d{2}$" },
          "revenue": { "type": ["number", "null"] },
          "operatingIncome": { "type": ["number", "null"] },
          "netIncome": { "type": ["number", "null"] },
          "totalAssets": { "type": ["number", "null"] },
          "totalLiabilities": { "type": ["number", "null"] },
          "shareholdersEquity": { "type": ["number", "null"] },
          "totalDebt": { "type": ["number", "null"] },
          "cashAndCashEquivalents": { "type": ["number", "null"] },
          "operatingCashFlow": { "type": ["number", "null"] },
          "capitalExpenditures": { "type": ["number", "null"] },
          "freeCashFlow": { "type": ["number", "null"] }
        }
      }
    },
    "valuation": {
      "type": ["object", "null"],
      "properties": {
        "asOfDate": { "type": ["string", "null"] },
        "sharePrice": { "type": ["number", "null"] },
        "sharesOutstanding": { "type": ["number", "null"] },
        "marketCapitalization": { "type": ["number", "null"] },
        "earningsPerShare": { "type": ["number", "null"] },
        "peRatio": { "type": ["number", "null"] },
        "priceToSalesRatio": { "type": ["number", "null"] }
      }
    },
    "sources": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "required": ["id", "sourceName", "dataType"],
        "properties": {
          "id": { "type": "string", "minLength": 1 },
          "sourceName": { "type": "string", "minLength": 1 },
          "sourceURL": { "type": ["string", "null"] },
          "filingDate": { "type": ["string", "null"] },
          "retrievedAt": { "type": ["string", "null"] },
          "dataType": { "enum": ["real", "synthetic"] }
        }
      }
    }
  }
}
